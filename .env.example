# Postgres connection string for Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Optional direct connection string (useful with pooled connections)
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Public site URL — set to your production domain (used for SEO, sitemap, Open Graph, robots.txt)
# NEXT_PUBLIC_SITE_URL="https://behindthetechz.live"

# Optional secret for cache revalidation endpoint (/api/revalidate)
# REVALIDATE_SECRET="change-me"

# Admin API authentication token (server-side)
# Primary variable name:
# BEHINDTHETECHZ_API_TOKEN="your-generated-token-here"
# Backward-compatible fallback (optional):
# ADMIN_API_TOKEN="your-generated-token-here"

# API base URL for CLI/client integrations
# Local development:
# BEHINDTHETECHZ_API_BASE_URL="http://localhost:3000"
# Vercel deployment:
# BEHINDTHETECHZ_API_BASE_URL="https://your-project.vercel.app"

# Author avatar URL (falls back to /himel-avatar.jpg if not set)
# NEXT_PUBLIC_AUTHOR_AVATAR="https://example.com/avatar.jpg"
