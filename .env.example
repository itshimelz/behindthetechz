# Postgres connection string for Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Optional direct connection string (useful with pooled connections)
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Public site URL — set to your production domain (used for SEO, sitemap, Open Graph, robots.txt)
# NEXT_PUBLIC_SITE_URL="https://behindthetechz.live"

# Optional secret for cache revalidation endpoint (/api/revalidate)
# REVALIDATE_SECRET="change-me"
